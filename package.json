{
  "name": "industrial-supplier-management",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "generate:api": "pnpm --filter @ism/api-client generate",
    "check:api": "pnpm --filter @ism/api-client check:generated",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --filter @ism/admin test:e2e"
  }
}
